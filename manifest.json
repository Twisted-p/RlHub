{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "RL Hub",
    "author": "Markus",
    "version": "0.2.5",
    "minimum-overwolf-version": "0.170.0",
    "description": "Rocket League hub for garage, training, dashboard and profile.",
    "icon": "App Logo.png"
  },
  "permissions": ["GameInfo", "Web"],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [10798]
    },
    "game_events": [10798],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [10798]
        },
        "start_minimized": true
      }
    ],
    "windows": {
      "background": {
        "file": "overwolf/background.html",
        "is_background_page": true
      },
      "overlay": {
        "file": "overwolf/overlay.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "in_game_only": true,
        "clickthrough": true,
        "isInputPassThrough": true,
        "grab_keyboard_focus": false,
        "keep_window_location": true,
        "restrict_to_game_bounds": true,
        "topmost": true,
        "disable_restore_animation": true,
        "start_position": {
          "top": 48,
          "left": 48
        },
        "size": {
          "width": 500,
          "height": 270
        },
        "min_size": {
          "width": 500,
          "height": 270
        },
        "max_size": {
          "width": 500,
          "height": 270
        }
      },
      "dashboard": {
        "file": "dashboard.html",
        "transparent": false,
        "resizable": true,
        "show_minimize": true,
        "size": {
          "width": 1180,
          "height": 820
        },
        "min_size": {
          "width": 980,
          "height": 680
        }
      },
      "garage": {
        "file": "garage.html",
        "transparent": false,
        "resizable": true,
        "show_minimize": true,
        "size": {
          "width": 1180,
          "height": 820
        },
        "min_size": {
          "width": 980,
          "height": 680
        }
      },
      "training": {
        "file": "training.html",
        "transparent": false,
        "resizable": true,
        "show_minimize": true,
        "size": {
          "width": 1180,
          "height": 820
        },
        "min_size": {
          "width": 980,
          "height": 680
        }
      },
      "profile": {
        "file": "profile.html",
        "transparent": false,
        "resizable": true,
        "show_minimize": true,
        "size": {
          "width": 1180,
          "height": 820
        },
        "min_size": {
          "width": 980,
          "height": 680
        }
      }
    }
  }
}
